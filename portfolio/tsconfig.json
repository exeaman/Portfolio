{
  "extends": "astro/tsconfigs/strict",

  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],

  "exclude": [
    "dist"
  ],

  "compilerOptions": {
    "baseUrl": ".",

    "jsx": "react-jsx",
    "jsxImportSource": "react",

    "paths": {
      "@/*": ["src/*"],

      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@styles/*": ["src/styles/*"],
      "@data/*": ["src/data/*"],
      "@lib/*": ["src/lib/*"],
      "@assets/*": ["src/assets/*"]
    }
  }
}