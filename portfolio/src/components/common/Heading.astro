---
import { cn } from "@lib/cn.ts";

interface Props {
    as?: "h1" | "h2" | "h3";
    eyebrow?: string;
    title: string;
    description?: string;
    align?: "left" | "center";
    class?: string;
}

const {
    as : Tag = "h2",
    eyebrow,
    title,
    description,
    align = "left",
    class: className,
} = Astro.props;
---

<div
        class={cn(
            "space-y-6",
            align === "center" && "text-center",
            className
        )}
>
    {
        eyebrow && (
                    <p class="text-sm font-medium uppercase tracking-[0.35em] text-zinc-500">
                        {eyebrow}
                    </p>
        )
    }

    <Tag class="text-5xl font-bold leading-[0.95] tracking-[-0.04em] md:text-7xl lg:text-8xl">
        {title}
    </Tag>

    {
        description && (
                    <p
                            class={cn(
                                "text-xl leading-8 text-zinc-400",
                                align === "center" && "mx-auto max-w-2xl"
                            )}
                    >
                        {description}
                    </p>
        )
    }
</div>