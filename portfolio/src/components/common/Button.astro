---
import {cn} from "@lib/cn.ts";
interface Props {
    variant?: "primary" | "secondary" | "ghost";
    href?: string;
    class?: string;
}

const {
    href,
    variant = "primary",
    class: className = ""
} = Astro.props;

const classes = cn("button", `button--${variant}`, className);
---

{
    href ? (
    <a href={href} class={classes}>
        <span><slot /></span>
        <slot name="icon" />
    </a>
        ) : (
    <button class={classes}>
        <span><slot /></span>
        <slot name="icon" />
    </button>
        )
    }