---
import { cn } from "@lib/cn";

interface Props {
    title: string;
    description: string;
    icon: any;
    technologies: string[];
    class?: string;
}

const {
    title,
    description,
    icon: Icon,
    technologies,
    class: className = ""
} = Astro.props;
---

<div
        class={cn(
            "glass group h-full rounded-3xl p-8 transition-all duration-300",
            className
        )}
>
    <div class="mb-6 inline-flex rounded-2xl border border-white/10 bg-white/5 p-3 text-zinc-400 transition-colors group-hover:text-violet-400">
        <Icon size={24} />
    </div>

    <h3 class="text-2xl font-semibold text-black">
        {title}
    </h3>

    <p class="mt-4 text-zinc-400 leading-7">
        {description}
    </p>

    <div class="mt-8 flex flex-wrap gap-2">
        {
            technologies.map((tech) => (
                    <span class="badge">
          {tech}
        </span>
            ))
        }
    </div>
</div>