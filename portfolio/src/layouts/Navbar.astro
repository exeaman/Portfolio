---
import Container from "@/components/common/Container.astro";
import Glass from "@/components/common/Glass.astro";
---

<header class="fixed inset-x-0 top-8 z-50 px-4">
    <Container class="max-w-4xl">
        <Glass
                variant="navbar"
                class="flex items-center justify-between rounded-full px-7 py-3"
        >
            <!-- Brand Logo -->
            <a
                    href="/"
                    class="group text-base font-semibold tracking-tight text-zinc-100"
            >
                Aman Jaiswal
                <span class="bg-linear-to-r from-sky-400 to-violet-400 bg-clip-text text-transparent transition-transform group-hover:scale-125">
          .
        </span>
            </a>

            <!-- Navigation Links -->
            <nav>
                <ul class="flex items-center gap-1 sm:gap-2 text-xs sm:text-sm font-bold text-zinc-600">
                    <li>
                        <a
                                href="#projects"
                                class="relative rounded-full px-3 py-1.5 transition-all duration-200 hover:bg-white/10 hover:text-white"
                        >
                            Projects
                        </a>
                    </li>

                    <li>
                        <a
                                href="#about"
                                class="relative rounded-full px-3 py-1.5 transition-all duration-200 hover:bg-white/10 hover:text-white"
                        >
                            About
                        </a>
                    </li>

                    <li>
                        <a
                                href="#contact"
                                class="relative ml-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 font-semibold text-white shadow-sm backdrop-blur-md transition-all duration-200 hover:border-sky-400/60 hover:bg-white/20"
                        >
                            Contact
                        </a>
                    </li>
                </ul>
            </nav>
        </Glass>
    </Container>
</header>